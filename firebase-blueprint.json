{
  "entities": {
    "system_branding": {
      "collection": "system_settings",
      "fields": {
        "logoUrl": { "type": "string" },
        "logoName": { "type": "string" },
        "commissionNameAm": { "type": "string" },
        "commissionNameEn": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "payroll_global_config": {
      "collection": "payroll_configs",
      "fields": {
        "useStatutoryTaxBrackets": { "type": "boolean" },
        "pensionEmployeeRate": { "type": "number" },
        "pensionEmployerRate": { "type": "number" },
        "taxBrackets": { "type": "array" },
        "standardDeductions": { "type": "array" },
        "defaultDutyAllowance": { "type": "number" },
        "defaultHazardAllowance": { "type": "number" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "salary_scales": {
      "collection": "salary_scales",
      "fields": {
        "scales": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "member_payrolls": {
      "collection": "member_payrolls",
      "fields": {
        "policeId": { "type": "string" },
        "customBaseSalary": { "type": "number" },
        "salaryGrade": { "type": "number" },
        "salaryStep": { "type": "number" },
        "monthlyAllowances": { "type": "object" },
        "additionalAllowances": { "type": "array" },
        "creditAssociationDeduction": { "type": "number" },
        "healthInsuranceDeduction": { "type": "number" },
        "redCrossDeduction": { "type": "number" },
        "courtOrDisciplinaryPenalty": { "type": "number" },
        "customDeductions": { "type": "array" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "firestore": {
    "defaultRules": "rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /{document=**} { allow read, write: if true; } } }"
  }
}
